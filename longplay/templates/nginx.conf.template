# 1. Automatically redirect all HTTP (port 80) traffic to HTTPS (port 443)
server {
    listen 80;
    server_name ${NGINX_DOMAIN};

    location / {
        return 301 https://$host$request_uri;
    }
}

# 2. Secure HTTPS (port 443) server
server {
    listen 443 ssl;
    server_name ${NGINX_DOMAIN};

    # Paths to the Let's Encrypt certificates mapped from the EC2 host
    ssl_certificate /etc/letsencrypt/live/${NGINX_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${NGINX_DOMAIN}/privkey.pem;

    # Modern, secure SSL settings
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    location / {
        # Pass traffic to the 'portal' container using Docker's internal DNS over port 8000
        proxy_pass http://portal:8000;
        
        # Forward the real user headers so your app knows who is connecting
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}